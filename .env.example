# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
POSTGRES_DB=uelplan
POSTGRES_USER=uelplan
POSTGRES_PASSWORD=doi-mat-khau-nay

# Nguồn chỉ-đọc cho scripts/import_supabase_to_local.ps1 (không lưu password).
# Direct connection hoặc Session pooler; Transaction pooler không phù hợp cho pg_dump.
SUPABASE_DB_HOST=db.project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_SSLMODE=require

API_PORT=8000
WEB_PORT=3000
# Môi trường chạy: development | production | staging
ENV=development
# URL mà TRÌNH DUYỆT dùng để gọi API (khi deploy: https://api.ten-mien-cua-ban)
PUBLIC_API_URL=http://localhost:8000
# Các origin được phép gọi API (khi deploy: https://ten-mien-cua-ban). Ở production cấm chứa localhost.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# PostgreSQL qua Supabase Transaction pooler cổng 6543 (mật khẩu giả):
# postgresql+psycopg://postgres.xxxxxxxx:MatKhauGia@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Số kết nối PostgreSQL giữ trong pool và số kết nối có thể mở thêm khi đầy.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Tự nạp dữ liệu mẫu khi DB trống: false (khuyên dùng cho production) | true
AUTO_SEED=false

# Đăng nhập & bảo mật phiên
# Production: PHẢI thay bằng chuỗi ngẫu nhiên dài (hàm validate_production sẽ chặn nếu giữ mặc định)
SESSION_SECRET=dev-only-change-me
# URL công khai của API cho callback OAuth (ví dụ https://api.ten-mien-cua-ban)
OAUTH_REDIRECT_BASE=http://localhost:8001
# URL frontend người dùng quay về sau đăng nhập (ví dụ https://ten-mien-cua-ban)
FRONTEND_BASE_URL=http://localhost:3001

# Khu vực quản trị (Admin) — Brief A0 & PLAN_ADMIN Mục 8
ADMIN_DEV_OPEN=false
ADMIN_BOOTSTRAP_PASSWORD=

# AI tra cứu quy chế: none (miễn phí, chỉ trích nguyên văn) | ollama | claude | codex
LLM_PROVIDER=none
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
CODEX_API_KEY=
CODEX_MODEL=gpt-6-sol
CODEX_BASE_URL=https://api.openai.com/v1
# Google Gemini (OpenAI-compatible endpoint): LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_REASONING_EFFORT=low
# Groq (OpenAI-compatible), dùng làm dự phòng: LLM_PROVIDER=gemini,groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=600
LLM_CONTEXT_CHUNKS=4
LLM_MAX_CONCURRENT=2
LLM_IP_HOURLY_CAP=10
LLM_IP_DAILY_CAP=30
# Gói miễn phí: Gemini 2.5 Flash ~250 lượt/ngày, Groq ~1000 lượt/ngày; giữ trần dưới mức của Gemini.
LLM_DAILY_CALL_CAP=200
LLM_CACHE_SECONDS=86400
LLM_LOG_QUESTIONS=false
LLM_HASH_SECRET=

# Chống cào dữ liệu & giới hạn tần suất (Brief S1)
# 240/phút cho mọi /api/*: phù hợp sinh viên dùng chung IP qua NAT trường
RATE_LIMIT_DEFAULT=240/minute
# 20/phút cho các endpoint nặng (hỏi đáp quy chế RAG, so sánh, xuất CSV)
RATE_LIMIT_HEAVY=20/minute
# Bật/tắt giới hạn tần suất: true (mặc định) | false (khi chạy test/dev)
RATE_LIMIT_ENABLED=true
# Chặn request không có User-Agent: false (mặc định để tránh lỗi SSR web) | true
BLOCK_EMPTY_USER_AGENT=false
