<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-21T05:05:20" agent="UELCourses" version="24.0.0" type="device"><diagram id="page1" name="1. Kiến trúc hệ thống"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;UELCourses — sơ đồ hệ thống hiện tại (ngày 2026-11-21)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1420" height="40" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Sinh viên&lt;/b&gt;&lt;br&gt;Trình duyệt (Chrome, di động)&lt;br&gt;Tra cứu học phần, lập TKB,&lt;br&gt;kế hoạch, quy chế, đánh giá" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF2CC;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="110" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Web — Next.js 15 + TypeScript + Tailwind&lt;/b&gt;&lt;br&gt;Cổng: 3001 (dev) / 3000 (prod)&lt;br&gt;Trang: Hôm nay · Học phần · TKB · Kế hoạch&lt;br&gt;CTĐT (cây môn học) · Phòng học · Tương đương&lt;br&gt;Quy chế &amp; AI · Cài đặt · Góp ý&lt;br&gt;Đang đổi: VI/EN, bộ lọc đủ cột, cây quan hệ&lt;br&gt;đầy đủ độ sâu, đăng nhập &amp; đánh giá" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DAE8FC;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="330" height="200" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;API — FastAPI (Python 3.14)&lt;/b&gt;&lt;br&gt;Cổng: 8001 (dev) / 8000 (prod), tài liệu /docs&lt;br&gt;Router: /semesters · /modules · /module-facets&lt;br&gt;/modules/{code}/outline · /modules/{code}/tree&lt;br&gt;/programs · /equivalents · /venues&lt;br&gt;/imports/* · /sync · /feedback&lt;br&gt;/auth/* (Google, Facebook) · /reviews&lt;br&gt;/regulations/* (RAG quy chế, nếu bật)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#DAE8FC;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="360" height="230" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Dịch vụ xử lý (app/services)&lt;/b&gt;&lt;br&gt;• importer — UIS xlsx, DKHP json, CTĐT json&lt;br&gt;• schedule_parser — buổi học, ngày, tiết x.5&lt;br&gt;• outline_parse — PDF đề cương → bảng có cấu trúc&lt;br&gt;• language — EN/VI, nhận diện CNTN&lt;br&gt;• moderation — kiểm duyệt đánh giá (từ khóa)&lt;br&gt;• auth — OAuth2 + phiên ký HMAC&lt;br&gt;• legacy — bỏ mã hệ cũ, khóa K19–K22&lt;br&gt;• english_names, sqlite sync (dev)&lt;br&gt;• RAG quy chế — trích dẫn nguyên văn Điều/Khoản" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#E1D5E7;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="380" height="260" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;PostgreSQL 17 + pgvector (Docker: db)&lt;/b&gt;&lt;br&gt;38 bảng · Alembic migration 0001 → 0008&lt;br&gt;JSONB, pg_trgm + unaccent (tìm không dấu)&lt;br&gt;Cổng 5432 (dev)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#D5E8D4;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="380" width="360" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Nguồn dữ liệu (nhập bằng script/CLI, không tự động)&lt;/b&gt;&lt;br&gt;• DKHP — dkhpapi.uel.edu.vn (tra cứu học phần, chỉ đọc, chậm)&lt;br&gt;• Portal UEL — portal.uel.edu.vn (CTĐT, tương đương, TKB cá nhân)&lt;br&gt;• Excel UIS danh sách lớp HK1 2025–2026 (chính thức)&lt;br&gt;• Excel kế hoạch môn tiếng Anh 2026–2027&lt;br&gt;• 783 PDF đề cương CTĐT 2025 (pdftotext + PyMuPDF)&lt;br&gt;• 50 văn bản quy chế (regulations/catalog.json)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#FFF2CC;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="600" height="230" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Dịch vụ ngoài (chưa bật / cần khóa)&lt;/b&gt;&lt;br&gt;• Google &amp; Facebook OAuth — cần tự tạo khóa&lt;br&gt;• Gemini (agy), Claude API, Ollama — dự phòng AI&lt;br&gt;  (chưa dùng cho nghiệp vụ chính)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#F8CECC;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="380" width="380" height="150" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Docker Compose (môi trường chuẩn)&lt;/b&gt;&lt;br&gt;db = Postgres · workspace = Python + Node dùng chung cho mọi AI · jobs = chạy lâu (parse, OCR) không bị ngắt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fillColor=#EFEFEF;strokeColor=#44546A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1420" height="70" as="geometry"/></mxCell><mxCell id="n11" value="HTTPS" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#44546A;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="REST / JSON" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#44546A;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="gọi nội bộ" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#44546A;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="SQLAlchemy 2" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#44546A;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="truy vấn" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#44546A;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="import / parse" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#B85450;" edge="1" parent="1" source="n8" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="OAuth / AI (tùy chọn)" style="endArrow=open;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Sơ đồ bảng dữ liệu"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n18" value="&lt;b&gt;Sơ đồ bảng dữ liệu (ERD)&lt;/b&gt; — 🔑 khóa chính · → khóa ngoại · * = NOT NULL · số dòng đo ngày 2026-11-21 · mũi tên = khóa ngoại (bảng con → bảng cha)" style="text;html=1;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Học phần &amp;amp; lịch học&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=15;fillColor=#F5F7FB;strokeColor=#9AA9C2;dashed=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="664" height="946" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;modules&lt;/b&gt; &lt;font color=#888888&gt;· 1486 dòng&lt;/font&gt;&lt;hr&gt;🔑 code &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   name &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   credits &lt;font color=#666666&gt;int&lt;/font&gt;&lt;br&gt;   type &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   faculty &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   department &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   is_english &lt;font color=#666666&gt;bool*&lt;/font&gt;&lt;br&gt;   description &lt;font color=#666666&gt;text&lt;/font&gt;&lt;br&gt;   prerequisites &lt;font color=#666666&gt;jsonb&lt;/font&gt;&lt;br&gt;   search_text &lt;font color=#666666&gt;text*&lt;/font&gt;&lt;br&gt;   is_sample &lt;font color=#666666&gt;bool*&lt;/font&gt;&lt;br&gt;   updated_at &lt;font color=#666666&gt;timestamptz*&lt;/font&gt;&lt;br&gt;   language_track &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   language_basis &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   counterpart_code &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   is_talent_program &lt;font color=#666666&gt;bool*&lt;/font&gt;&lt;br&gt;   name_en &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   name_en_source &lt;font color=#666666&gt;varchar&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="300" height="336" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;class_sections&lt;/b&gt; &lt;font color=#888888&gt;· 5879 dòng&lt;/font&gt;&lt;hr&gt;🔑 id &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;   class_code &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;→ module_code &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;→ semester_id &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   lecturer &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   quota &lt;font color=#666666&gt;int&lt;/font&gt;&lt;br&gt;   quota_min &lt;font color=#666666&gt;int&lt;/font&gt;&lt;br&gt;   registered &lt;font color=#666666&gt;int&lt;/font&gt;&lt;br&gt;   available &lt;font color=#666666&gt;int&lt;/font&gt;&lt;br&gt;   student_groups &lt;font color=#666666&gt;jsonb&lt;/font&gt;&lt;br&gt;   cohorts &lt;font color=#666666&gt;jsonb&lt;/font&gt;&lt;br&gt;   rooms &lt;font color=#666666&gt;jsonb&lt;/font&gt;&lt;br&gt;   notes &lt;font color=#666666&gt;jsonb&lt;/font&gt;&lt;br&gt;   source &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   start_date &lt;font color=#666666&gt;date&lt;/font&gt;&lt;br&gt;   end_date &lt;font color=#666666&gt;date&lt;/font&gt;&lt;br&gt;   study_type &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   schedule_raw &lt;font color=#666666&gt;text&lt;/font&gt;&lt;br&gt;   is_sample &lt;font color=#666666&gt;bool*&lt;/font&gt;&lt;br&gt;   updated_at &lt;font color=#666666&gt;timestamptz*&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="384" y="120" width="300" height="368" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;lessons&lt;/b&gt; &lt;font color=#888888&gt;· 6706 dòng&lt;/font&gt;&lt;hr&gt;🔑 id &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;→ class_id &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;   weekday &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;   start_period &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;   end_period &lt;font color=#666666&gt;float*&lt;/font&gt;&lt;br&gt;   start_time &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   end_time &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;→ room &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   weeks &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   raw &lt;font color=#666666&gt;text&lt;/font&gt;&lt;br&gt;   date_start &lt;font color=#666666&gt;date&lt;/font&gt;&lt;br&gt;   date_end &lt;font color=#666666&gt;date&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="60" y="472" width="300" height="240" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;venues&lt;/b&gt; &lt;font color=#888888&gt;· 140 dòng&lt;/font&gt;&lt;hr&gt;🔑 room &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   capacity &lt;font color=#666666&gt;int&lt;/font&gt;&lt;br&gt;   is_sample &lt;font color=#666666&gt;bool*&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="384" y="504" width="300" height="96" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;semesters&lt;/b&gt; &lt;font color=#888888&gt;· 7 dòng&lt;/font&gt;&lt;hr&gt;🔑 id &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   name &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   year &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   term &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;   start_date &lt;font color=#666666&gt;date&lt;/font&gt;&lt;br&gt;   end_date &lt;font color=#666666&gt;date&lt;/font&gt;&lt;br&gt;   is_current_override &lt;font color=#666666&gt;bool&lt;/font&gt;&lt;br&gt;   is_sample &lt;font color=#666666&gt;bool*&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#44546A;" vertex="1" parent="1"><mxGeometry x="384" y="616" width="300" height="176" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;module_offering_plans&lt;/b&gt; &lt;font color=#888888&gt;· 183 dòng&lt;/font&gt;&lt;hr&gt;🔑 id &lt;font color=#666666&gt;int*&lt;/font&gt;&lt;br&gt;→ module_code &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   academic_year &lt;font color=#666666&gt;varchar*&lt;/font&gt;&lt;br&gt;   terms &lt;font color=#666666&gt;jsonb*&lt;/font&gt;&lt;br&gt;   terms_text &lt;font color=#666666&gt;varchar&lt;/font&gt;&lt;br&gt;   open_pct &lt;font color=#666666&gt;float&lt;/font&gt;&lt;br&gt;   lecture_hours &lt;font color=#666666&gt;float&lt;/font&gt;&lt;br&gt;   note &lt;font color=#666666&gt;text&lt;/font&gt;&lt;br&gt;   source &lt;font color=#666666&gt;varchar&lt;/font&gt;" style=